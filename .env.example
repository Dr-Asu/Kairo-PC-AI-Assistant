# Copy this file to .env and fill in your own free keys. Never commit .env.
# Groq free tier — get a key at https://console.groq.com/keys
GROQ_API_KEY=
# Google AI Studio (Gemini) free tier — get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Token for the local dashboard / phone bridge (pick any long random string)
KAIRO_TOKEN=
# Preferred reply language: en (English) or ur (Roman Urdu)
KAIRO_LANGUAGE=en
# Optional: data folder for memory, logs and tasks (default: ~/.kairo)
KAIRO_DATA_DIR=
# Optional: dry-run mode for testing on a non-Windows machine (true/false)
KAIRO_DRY_RUN=false
